---
/**
 * "How a group buy works" is the scroll story (FEAT-028 T5c): the four steps on the left are
 * lit one by one as you scroll; on the right a sticky second scene — camera orbit, towers
 * rising, windows filling, the price in the HUD dropping, a burst when the deadline closes —
 * is driven by story.ts from the same scroll position. Without JS the steps read as a list.
 */
import Section from './Section.astro';
import FeatureList from './FeatureList.astro';
import { demoRound, featuresIn, sections } from '../content/features';
import { rupees } from '../scene/model';
const s = sections.find((x) => x.id === 'how')!;
const target = demoRound.tiers[demoRound.tiers.length - 1]?.units ?? 10;
const single = demoRound.tiers[0]?.price ?? 0;
const steps = [
  { title: 'The operator opens a round', text: 'One service, one society, a deadline, and a price ladder negotiated with a vendor: ₹1,000 alone, ₹800 at 5 ACs, ₹700 at 10.' },
  { title: 'You pledge what you need', text: 'Two ACs, three rooms, one 25 kg pack. One tap, and an SMS confirms it. Change or leave any time before the deadline.' },
  { title: 'Neighbours join, the price drops', text: 'Every pledge moves the ladder for everyone. Share the round to the society group with one tap; the people you bring in lower your own price.' },
  { title: 'The deadline closes it, a person books it', text: 'At the deadline the round closes on its own. The operator assigns the vendor at the unlocked price, the job gets done, and you rate it.' },
];
---

<Section id={s.id} title={s.title} lede={s.lede}>
  <div class="story" data-story data-story-target={target}>
    <ol class="steps story__steps" data-story-track>
      {steps.map((st) => (
        <li class="step story__step" data-story-step>
          <h3>{st.title}</h3>
          <p>{st.text}</p>
        </li>
      ))}
    </ol>
    <div class="story__stage">
      <div class="scene story__scene" data-story-scene role="img" aria-label="The same society, filling as the steps go by">
        <div class="hud" aria-hidden="true">
          <div class="hud__row">
            <span class="pill pill--live" data-hud-state>Opening</span>
            <span class="hud__units figure" data-hud-units>0 of {target}</span>
          </div>
          <div class="hud__price figure"><span data-hud-price>{rupees(single)}</span><small>per {demoRound.unit}</small></div>
          <div class="ladder__track hud__track"><div class="ladder__fill" data-hud-fill></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="story__after">
    <FeatureList items={featuresIn('how')} />
  </div>
</Section>
