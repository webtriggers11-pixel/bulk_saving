---
interface Props {
  id: string;
  title: string;
  lede: string;
}
const { id, title, lede } = Astro.props;
---

<section class="section reveal" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="section__head">
      <h2 id={`${id}-title`}>{title}</h2>
      <p>{lede}</p>
    </header>
    <slot />
  </div>
</section>
