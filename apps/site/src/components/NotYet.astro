---
import Section from './Section.astro';
import { notYet } from '../content/features';
---

<Section id="not-yet" title="What is not here yet" lede="So the next screen never surprises you.">
  <table class="table">
    <thead><tr><th>Thing</th><th>Where it stands</th><th>What that means for you</th></tr></thead>
    <tbody>
      {notYet.map((n) => (
        <tr><td>{n.item}</td><td>{n.state}</td><td>{n.say}</td></tr>
      ))}
    </tbody>
  </table>
</Section>
