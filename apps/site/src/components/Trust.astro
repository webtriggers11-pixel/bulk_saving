---
import Section from './Section.astro';
import FeatureList from './FeatureList.astro';
import { featuresIn, sections } from '../content/features';
const s = sections.find((x) => x.id === 'trust')!;
---

<Section id={s.id} title={s.title} lede={s.lede}>
  <div class="split split--flip">
    <FeatureList items={featuresIn('trust')} />
    <div class="phone" aria-hidden="true">
      <div class="phone__bar"><span>9:41</span><span>Ops</span></div>
      <div class="phone__title">Vendors</div>
      <div class="surface card">
        <div class="card__row"><span class="card__title">CoolCare Services</span><span class="card__price figure">4.6</span></div>
        <div class="card__meta">AC servicing · 7 rounds delivered · 38 ratings</div>
      </div>
      <div class="surface card">
        <div class="card__row"><span class="card__title">PestFree Pune</span><span class="card__price figure">4.2</span></div>
        <div class="card__meta">Pest control · 3 rounds delivered · 19 ratings</div>
      </div>
      <div class="surface card">
        <div class="card__row"><span class="card__title">AquaClean</span><span class="card__price figure">3.4</span></div>
        <div class="card__meta">Water tank · 2 rounds delivered · 9 ratings · review before next assignment</div>
      </div>
      <div class="surface card">
        <div class="card__title">Payments, AC servicing</div>
        <div class="card__row"><span class="card__meta">A-204 · 2 ACs · ₹1,400</span><span class="card__btn card__btn--on">Collected</span></div>
        <div class="card__row"><span class="card__meta">B-101 · 1 AC · ₹700</span><span class="card__btn">Mark collected</span></div>
      </div>
    </div>
  </div>
</Section>
