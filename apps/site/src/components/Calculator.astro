---
/**
 * FEAT-028 T5e — an interactive what-if: a society's yearly savings and the platform's
 * illustrative revenue from the inputs a financier would ask about. Defaults are the
 * BRIEF's worked example; every input is a slider; it says it is an illustration.
 */
import { DEFAULTS, calc } from '../scene/calc';
const d = DEFAULTS;
const o = calc(d);
const sliders = [
  { key: 'flats', label: 'Flats in the society', min: 50, max: 600, step: 10, value: d.flats },
  { key: 'joining', label: 'Flats joining at least one round a year', min: 5, max: 80, step: 5, value: d.joining * 100 },
  { key: 'jobsPerFlat', label: 'Jobs per joining flat, per year', min: 1, max: 8, step: 1, value: d.jobsPerFlat },
  { key: 'singlePrice', label: 'Average single-customer price per job', min: 300, max: 5000, step: 100, value: d.singlePrice },
  { key: 'discount', label: 'Pooled discount', min: 10, max: 45, step: 5, value: d.discount * 100 },
  { key: 'takeRate', label: 'Platform commission (illustrative)', min: 0, max: 25, step: 1, value: d.takeRate * 100 },
];
const fmt = (k: string, v: number) => (k === 'joining' || k === 'discount' || k === 'takeRate' ? `${v}%` : k === 'singlePrice' ? `₹${v.toLocaleString('en-IN')}` : String(v));
---

<section class="section reveal" id="calculator" aria-labelledby="calculator-title">
  <div class="wrap">
    <header class="section__head">
      <h2 id="calculator-title">What one society is worth</h2>
      <p>Move the sliders. The defaults are the brief's worked example (₹1,000 → ₹700 for one AC service); the commission is an illustration, not a term.</p>
    </header>
    <div class="calc" data-calc-root>
      <div class="calc__inputs surface">
        {sliders.map((s) => (
          <label class="calc__row" for={`calc-${s.key}`}>
            <span class="calc__label">{s.label}<output class="figure" data-calc-value={s.key} for={`calc-${s.key}`}>{fmt(s.key, s.value)}</output></span>
            <input id={`calc-${s.key}`} type="range" data-calc={s.key} min={s.min} max={s.max} step={s.step} value={s.value} aria-label={s.label} />
          </label>
        ))}
      </div>
      <div class="calc__outputs sticky-col">
        <div class="surface--accent calc__hero">
          <span class="calc__k">The society saves, per year</span>
          <strong class="figure calc__big" data-calc-out="societySavings">₹{o.societySavings.toLocaleString('en-IN')}</strong>
          <span class="calc__k">that is <strong class="figure" data-calc-out="perFlatSavings">₹{o.perFlatSavings.toLocaleString('en-IN')}</strong> per flat averaged over every flat, across <strong class="figure" data-calc-out="jobs">{o.jobs}</strong> pooled jobs</span>
        </div>
        <div class="tiles" style="grid-template-columns: repeat(2, minmax(0, 1fr))">
          <div class="surface tile"><strong class="figure" data-calc-out="pooledPrice">₹{o.pooledPrice}</strong><span>pooled price per job</span></div>
          <div class="surface tile"><strong class="figure" data-calc-out="savingPerJob">₹{o.savingPerJob}</strong><span>saved per job vs going alone</span></div>
          <div class="surface tile"><strong class="figure" data-calc-out="gmv">₹{o.gmv.toLocaleString('en-IN')}</strong><span>pooled spend through the platform, per year</span></div>
          <div class="surface tile"><strong class="figure" data-calc-out="platformRevenue">₹{o.platformRevenue.toLocaleString('en-IN')}</strong><span>platform revenue at the illustrative commission</span></div>
        </div>
        <p class="small muted">One society. The platform is built for many: a new society is an invite code.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountCalculator } from '../scene/overview';
  document.querySelectorAll<HTMLElement>('[data-calc-root]').forEach(mountCalculator);
</script>
