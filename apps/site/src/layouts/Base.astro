---
/**
 * FEAT-028: the page shell. The <html> attributes, the pre-paint script and the storage keys
 * are the app's (apps/web/index.html, ADR-0028/0031), so a resident who opens this site gets
 * the colour they chose in the app, and a visitor gets Mono in their phone's scheme.
 */
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/fx.css';
import 'lenis/dist/lenis.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// `site` comes from astro.config; the container (tests) may render without one.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const nav = [
  { href: '#how', label: 'How it works' },
  { href: '#book', label: 'Services' },
  { href: '#notify', label: 'Updates' },
  { href: '#trust', label: 'Trust' },
  { href: '#phone', label: 'Phone' },
  { href: '#look', label: 'Look' },
  { href: '#operators', label: 'Operators' },
  { href: '#staples', label: 'Staples' },
  { href: '#not-yet', label: 'Not yet' },
];
---

<!doctype html>
<html lang="en" data-look="vercel" data-theme="mono" data-accent="mono" data-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="rgb(250, 250, 250)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Bulk Saving" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        var d = document.documentElement, pref = 'system', pal = 'mono';
        var ACCENTS = ['mono', 'ocean', 'aurora', 'bloom', 'sunset', 'forest', 'lagoon'];
        var LEGACY = { teal: 'lagoon', indigo: 'aurora', ember: 'sunset' };
        try {
          pref = localStorage.getItem('bulk:scheme') || 'system';
          pal = localStorage.getItem('bulk:palette') || 'mono';
        } catch (e) {}
        var dark = pref === 'dark' || (pref !== 'light' && window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (ACCENTS.indexOf(pal) < 0) pal = Object.prototype.hasOwnProperty.call(LEGACY, pal) ? LEGACY[pal] : 'mono';
        d.setAttribute('data-scheme', dark ? 'dark' : 'light');
        d.setAttribute('data-look', 'vercel');
        d.setAttribute('data-theme', 'mono');
        d.setAttribute('data-accent', pal);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? 'rgb(10, 10, 10)' : 'rgb(250, 250, 250)');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@500;600&display=swap"
    />
  </head>
  <body>
    <div class="ground" aria-hidden="true"></div>

    <header class="nav">
      <div class="wrap nav__in">
        <a class="brand" href="#top" aria-label="Bulk Saving, home">
          <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          Bulk Saving
        </a>
        <nav class="nav__links" aria-label="Sections">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <button class="icon-btn" type="button" data-toggle-scheme aria-label="Switch between light and dark">
          <svg class="icon-btn__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="icon-btn__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="wrap footer">
      <span>Bulk Saving. Group buys for housing societies, one city at a time.</span>
      <nav aria-label="Footer">
        <a href="#how">How it works</a>
        <a href="#operators">For operators</a>
        <a href="#not-yet">What is not here yet</a>
        <a href="mailto:hello@bulksaving.example">Talk to us</a>
      </nav>
    </footer>

    <script>
      import { mountThemeControls } from '../scene/theme';
      import { mountFx } from '../scene/fx';
      import { mountMotion } from '../scene/motion';
      import { mountCatalog } from '../scene/catalog';
      mountThemeControls();
      mountFx();
      mountMotion();
      document.querySelectorAll<HTMLElement>('[data-catalog]').forEach(mountCatalog);
    </script>
  </body>
</html>
