// Prisma schema — FEAT-001 (society onboarding + phone-OTP auth).
// Shared-schema multi-tenancy (ADR-0003): every tenant-scoped row carries societyId.
// Real domain models (Round, Job, ...) arrive with later features.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  SUPER_ADMIN
}

// Round lifecycle (FEAT-004, ADR-0011). Full state machine:
// OPEN -> CLOSED_MET | CLOSED_EXPIRED -> ASSIGNED -> DELIVERED -> RATED,
// plus CANCELLED (admin, from any pre-DELIVERED state). All transitions are
// guarded in RoundsService; the deadline-driven OPEN->CLOSED_* transition is
// performed by the BullMQ RoundCloserProcessor under the round row lock.
enum RoundStatus {
  OPEN
  CLOSED_MET
  CLOSED_EXPIRED
  ASSIGNED
  DELIVERED
  RATED
  CANCELLED
}

// Notifications (FEAT-006, ADR-0013). Lifecycle SMS types only — the login OTP is
// sent synchronously and is NEVER persisted (an OTP row would be a stored credential).
enum NotificationType {
  ROUND_JOINED
  ROUND_CLOSING_SOON
  ROUND_CLOSED_MET
  ROUND_CLOSED_EXPIRED
  ROUND_ASSIGNED
  ROUND_DELIVERED
  ROUND_CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Society {
  id         String            @id @default(cuid())
  name       String
  city       String
  inviteCode String            @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  residents  Resident[]
  offerings  ServiceOffering[]
  rounds     Round[]
}

model Resident {
  id         String    @id @default(cuid())
  societyId  String
  society    Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  phone      String
  name       String?
  role       Role      @default(RESIDENT)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  roundParticipations RoundParticipant[]
  notifications       Notification[]
  ratings             Rating[]

  @@unique([societyId, phone])
}

// Catalog (FEAT-002, ADR-0009): a global Service master (super-admin managed)
// + per-society ServiceOffering availability. Service is a platform-wide table;
// ServiceOffering is tenant-scoped (carries societyId per ADR-0003).
model Service {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String
  category    String
  imageUrl    String?
  active      Boolean           @default(true)

  // What ONE unit of this service is (FEAT-010, ADR-0019). `units` is the currency of
  // the whole mechanic — thresholds count them and `finalPrice × units` bills them — so
  // a service that does not say what a unit IS leaves a resident committing to an
  // undefined quantity (Painting: a room? a wall? the flat?). Plural is STORED, never
  // derived by appending "s": "1 flats" in a bill is how trust is lost. Both default to
  // "unit"/"units", so a service without labels degrades to today's wording rather than
  // to an empty string. `unitDescription` carries the scope sentence, which is the part
  // that actually settles arguments ("One room, walls only, up to 12x12 ft").
  unitLabel       String  @default("unit")
  unitLabelPlural String  @default("units")
  unitDescription String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  offerings   ServiceOffering[]
  rounds      Round[]
}

model ServiceOffering {
  id              String   @id @default(cuid())
  societyId       String
  society         Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  indicativePrice Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([societyId, serviceId])
}

// Group-buy rounds (FEAT-003, ADR-0010). A round is a time-boxed group-buy for
// one Service in one Society with ascending unit-threshold price tiers.
// `unitsCount` is the AUTHORITATIVE unit total, mutated only inside atomic
// transactions together with the participant rows (ADR-0004). At most one OPEN
// round per (societyId, serviceId) — enforced by a partial unique index added
// in the migration (Prisma has no declarative partial-unique).
model Round {
  id            String             @id @default(cuid())
  societyId     String
  society       Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status        RoundStatus        @default(OPEN)
  unitsCount    Int                @default(0)
  deadline      DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tiers         RoundTier[]
  participants  RoundParticipant[]
  notifications Notification[]
  ratings       Rating[]

  // Assignment + delivery (FEAT-005, ADR-0012). Written ONLY inside
  // RoundsService.transition() in the same guarded, row-locked update as the
  // status change. `finalPrice` is the negotiated integer ₹ per unit.
  vendorId    String?
  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  finalPrice  Int?
  assignedAt  DateTime?
  deliveredAt DateTime?

  @@index([societyId, status])
  @@index([status])
}

// A price tier: when the round's unitsCount reaches `threshold`, `price`
// (integer rupees) becomes the current price. Thresholds are strictly ascending.
model RoundTier {
  id        String @id @default(cuid())
  roundId   String
  round     Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  threshold Int
  price     Int

  @@index([roundId])
}

// One resident's pledge in a round. `units` (>=1) is this resident's contribution
// to the round's authoritative unitsCount. One row per (round, resident).
model RoundParticipant {
  id                 String    @id @default(cuid())
  roundId            String
  round              Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  residentId         String
  resident           Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  units              Int
  // Manual payment flag (FEAT-005, ADR-0012): null = not collected. Amount due is
  // round.finalPrice × units; the admin can set and clear it once a vendor is assigned.
  paymentCollectedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([roundId, residentId])
  @@index([residentId])
}

// Vendors (FEAT-005, ADR-0012): a GLOBAL (city-level, not society-scoped) list the
// super-admin manages. Vendors have no login. Rounds reference a vendor with
// onDelete: Restrict, so vendors are deactivated (`active = false`), never deleted.
model Vendor {
  id        String   @id @default(cuid())
  name      String
  phone     String
  category  String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rounds    Round[]
}

// Transactional notification outbox (FEAT-006, ADR-0013). A row is written in the
// SAME transaction as the round change that caused it, so a rolled-back change can
// never send and a committed one always has a durable record. Dispatch to the
// `notifications` BullMQ queue happens AFTER commit (one job per row, jobId = id);
// `dedupeKey` is unique in the DB, which is what makes a retried job, a double-fired
// scheduler and an idempotent re-close all safe.
model Notification {
  id         String             @id @default(cuid())
  residentId String
  resident   Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  roundId    String?
  round      Round?             @relation(fields: [roundId], references: [id], onDelete: Cascade)
  type       NotificationType
  status     NotificationStatus @default(PENDING)
  // Rendered at stage time by the pure template functions. Never contains an OTP,
  // a token, or a phone number.
  body       String
  // `<TYPE>:<roundId>:<residentId>` for lifecycle fan-outs;
  // `ROUND_JOINED:<participantId>` for join confirmations (a rejoin after leaving
  // is a new participant row, so it legitimately gets a new confirmation).
  dedupeKey  String             @unique
  attempts   Int                @default(0)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([residentId, createdAt])
}

// Post-service rating (FEAT-007, ADR-0017). One row per (round, resident): the
// rating hangs off the ROUND, not the vendor, so it is always attributable to the
// job that was actually done and to the vendor who did it (the round carries
// `vendorId`, ADR-0012). A vendor's score is aggregated through their rounds on
// read rather than denormalised here. `stars` is 1..5, enforced by the DTO.
model Rating {
  id         String   @id @default(cuid())
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roundId, residentId])
  @@index([roundId])
}
