// Prisma schema — FEAT-001 (society onboarding + phone-OTP auth).
// Shared-schema multi-tenancy (ADR-0003): every tenant-scoped row carries societyId.
// Real domain models (Round, Job, ...) arrive with later features.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  SUPER_ADMIN
}

model Society {
  id         String             @id @default(cuid())
  name       String
  city       String
  inviteCode String             @unique
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  residents  Resident[]
  offerings  ServiceOffering[]
}

model Resident {
  id         String    @id @default(cuid())
  societyId  String
  society    Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  phone      String
  name       String?
  role       Role      @default(RESIDENT)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([societyId, phone])
}

// Catalog (FEAT-002, ADR-0009): a global Service master (super-admin managed)
// + per-society ServiceOffering availability. Service is a platform-wide table;
// ServiceOffering is tenant-scoped (carries societyId per ADR-0003).
model Service {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String
  category    String
  imageUrl    String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  offerings   ServiceOffering[]
}

model ServiceOffering {
  id              String   @id @default(cuid())
  societyId       String
  society         Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  indicativePrice Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([societyId, serviceId])
}
