DATABASE_URL=postgresql://postgres:postgres@localhost:5442/bulk_saving?schema=public
REDIS_HOST=localhost
REDIS_PORT=6399
PORT=3000

# Auth (FEAT-001 / ADR-0007). Generate strong random values per environment.
# These placeholders are NOT secrets — real secrets live in the (gitignored) .env.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token lifetime in seconds. Unset or 0 = sessions NEVER expire (ADR-0024),
# which is the default: one OTP per device, forever. Set a positive number to restore
# an expiring session. Revoking a session is `DEL refresh:<residentId>` in Redis, and
# takes effect within one JWT_ACCESS_TTL_SECONDS.
JWT_REFRESH_TTL_SECONDS=0
OTP_HASH_SECRET=change-me-otp-hash-secret

# DEV ONLY — when 'true' AND NODE_ENV is explicitly development or test, the stub SMS
# channel logs the raw OTP, stashes it in Redis for 120s (`dev:last-otp:<phone>`), and the
# dev-only route GET /dev/otp?phone= answers loopback callers with it so the web app's DEV
# build shows it as a toast (FEAT-026, ADR-0037). The auth responses never carry it
# (CHORE-007, ADR-0020). Unset NODE_ENV = off; NODE_ENV=production refuses the flag at boot.
# Leave 'false' outside local development. NEVER enable in production.
OTP_DEV_LOG=false
# DEV ONLY (CHORE-026, ADR-0040) — when set (4–6 digits) AND NODE_ENV is exactly development,
# every resident and admin OTP is this code (e.g. 1111). Ignored under test; production
# refuses to boot with it set.
# OTP_DEV_FIXED_CODE=1111
# Required for the dev OTP echo above (an unset NODE_ENV is treated as not-development).
NODE_ENV=development

# CORS allowlist (BUG-003 / ADR-0014) — comma-separated exact origins allowed to
# call this API from a browser. Leave UNSET in local dev: any http://localhost:<port>
# is then allowed, so a shifted Vite port just works. REQUIRED in production —
# unset there means no browser origin is allowed at all.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Behind a reverse proxy: how many proxies are in front of the API (e.g. 1), or their
# addresses. Per-client OTP budgets and the throttler need the real client IP (ADR-0027).
# Never `true`. Leave unset when nothing is in front of the API.
# TRUST_PROXY=1

# Web push (FEAT-020, ADR-0032). All three or none — without them push is switched off.
# Generate a pair: `node -e "console.log(require('web-push').generateVAPIDKeys())"` in apps/backend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Optional worker tuning: parallel sends per process, and a ceiling across all workers.
# PUSH_CONCURRENCY=20
# PUSH_RATE_PER_SECOND=200

# Sign in with WhatsApp — "Tap to verify" (FEAT-027, ADR-0038). ALL FIVE OR NONE: a partial
# set refuses to boot. With all five the API talks to Meta's WhatsApp Cloud API; with none and
# OTP_DEV_LOG=true (NODE_ENV=development) the method still works locally through the dev
# simulator (stub mode); with none otherwise it is simply not offered.
#   PHONE_NUMBER_ID  — the numeric id of your business number in the Meta app (WhatsApp → API Setup)
#   ACCESS_TOKEN     — a System User token with whatsapp_business_messaging (never the 24-hour temporary one in production)
#   APP_SECRET       — the Meta app's App Secret (signs every webhook delivery)
#   VERIFY_TOKEN     — any random string; paste the same one into the webhook's "Verify token" field
#   BUSINESS_NUMBER  — the number residents message, digits with country code, no +, e.g. 919876543210
# The webhook URL to register is https://<your-api-host>/webhooks/whatsapp (subscribe to "messages").
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_BUSINESS_NUMBER=
# Graph API version for the Cloud API calls (default v26.0; versions are supported ~2 years).
# WHATSAPP_GRAPH_VERSION=v26.0
