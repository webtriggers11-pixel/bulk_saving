DATABASE_URL=postgresql://postgres:postgres@localhost:5442/bulk_saving?schema=public
REDIS_HOST=localhost
REDIS_PORT=6399
PORT=3000

# Auth (FEAT-001 / ADR-0007). Generate strong random values per environment.
# These placeholders are NOT secrets — real secrets live in the (gitignored) .env.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token lifetime in seconds. Unset or 0 = sessions NEVER expire (ADR-0024),
# which is the default: one OTP per device, forever. Set a positive number to restore
# an expiring session. Revoking a session is `DEL refresh:<residentId>` in Redis, and
# takes effect within one JWT_ACCESS_TTL_SECONDS.
JWT_REFRESH_TTL_SECONDS=0
OTP_HASH_SECRET=change-me-otp-hash-secret

# DEV ONLY — when 'true', the raw OTP is exposed for local clicking: the stub SMS
# channel logs it, AND POST /auth/otp/request returns it as `devCode` so the web app
# can show it in a toast (CHORE-002, ADR-0016). That is a full auth bypass for anyone
# who knows an invite code and a phone number, so it is ALSO refused whenever
# NODE_ENV=production — the flag alone cannot expose it there.
# Leave 'false' outside local development. NEVER enable in production.
OTP_DEV_LOG=false

# CORS allowlist (BUG-003 / ADR-0014) — comma-separated exact origins allowed to
# call this API from a browser. Leave UNSET in local dev: any http://localhost:<port>
# is then allowed, so a shifted Vite port just works. REQUIRED in production —
# unset there means no browser origin is allowed at all.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Behind a reverse proxy: how many proxies are in front of the API (e.g. 1), or their
# addresses. Per-client OTP budgets and the throttler need the real client IP (ADR-0027).
# Never `true`. Leave unset when nothing is in front of the API.
# TRUST_PROXY=1
