# Production configuration (CHORE-007). Copy to `.env.prod` and fill in REAL values.
# The API refuses to boot if any of this is unsafe — see assertProductionSafe().

# --- Postgres (the compose stack creates this database) ---
POSTGRES_USER=bulk
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=bulk_saving
DATABASE_URL=postgresql://bulk:__GENERATE__@postgres:5432/bulk_saving?schema=public

# --- Secrets. Generate each one separately, e.g. `openssl rand -base64 48`. ---
# Minimum 16 chars, and NEVER an example value from this repo: the API checks both.
JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
OTP_HASH_SECRET=__GENERATE__
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token lifetime in seconds. Unset or 0 = sessions NEVER expire (ADR-0024),
# which is the default: one OTP per device, forever. Set a positive number to restore
# an expiring session. Revoking a session is `DEL refresh:<residentId>` in Redis, and
# takes effect within one JWT_ACCESS_TTL_SECONDS.
JWT_REFRESH_TTL_SECONDS=0

# --- CORS: REQUIRED in production. Exact browser origins, comma-separated. ---
# Unset means no browser can call the API at all (ADR-0014 fails closed), and the
# API will refuse to start rather than look mysteriously broken.
CORS_ORIGINS=https://app.example.com

# --- The PWA's API base URL, baked in at build time. ---
VITE_API_URL=https://api.example.com

# --- Published ports on the host ---
API_PORT=3000
WEB_PORT=8080

# NOTE: OTP_DEV_LOG must NOT appear here. Setting it to `true` in production makes the
# API refuse to boot, because it exposes one-time passcodes.
